.DS_Store
.claude/worktrees/

# Local dev only — never commit
admin/config.local.php

# Live-edited on server via the admin panel — code that writes to these
# paths ships via git (push, then `git pull` on the server); the content itself is never git-tracked.
data/*.json
data/backups/
creations/blogs/*.md
creations/blogs/backups/
navigation/resources/markdown/
navigation/learning/markdown/

# Binary assets — managed on server directly, not via git
images/
# The old site (its own git repo, ~600MB of media), copied to the server as-is with rsync
soniapolis_v1/

# Delete from server after running once
admin/setup.php
