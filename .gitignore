.DS_Store
.claude/worktrees/

# Local dev only — never commit
admin/config.local.php

# Live-edited on server via the admin panel — code that writes to these
# paths ships via deploy.sh; the content itself is never git-tracked.
data/*.json
data/backups/
creations/blogs/*.md
creations/blogs/backups/
navigation/resources/markdown/

# Binary assets — managed on server directly, not via git
images/

# Delete from server after running once
admin/setup.php
